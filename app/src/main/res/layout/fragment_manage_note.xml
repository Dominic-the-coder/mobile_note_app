<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/manageNoteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1B1D1E">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:contentDescription="Close note editor"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/editorHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="New note"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/saveNoteButton"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_filter"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

    </LinearLayout>

    <!-- Note Title -->
    <EditText
        android:id="@+id/editTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Title"
        android:textColor="#FFFFFF"
        android:textColorHint="#A9AAAA"
        android:textSize="25sp"
        android:textStyle="bold"
        android:background="@android:color/transparent"
        android:singleLine="true"
        android:inputType="textCapSentences"
        android:padding="0dp" />

    <!-- Note Content -->
    <EditText
        android:id="@+id/editContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="top|start"
        android:hint="Start writing..."
        android:textColor="#F0F0F0"
        android:textColorHint="#888888"
        android:textSize="15sp"
        android:background="@android:color/transparent"
        android:inputType="textMultiLine|textCapSentences"
        android:paddingTop="8dp" />

    <!-- Color Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Colour"
        android:textColor="#E8E8E8"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Color Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/colorChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/color0"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:checkable="true"
                android:contentDescription="Default color"
                app:chipBackgroundColor="@color/Charcoal"
                app:chipCornerRadius="16dp"
                app:chipStrokeWidth="1dp"
                app:checkedIconVisible="true"
                app:checkedIcon="@drawable/ic_check"
                app:checkedIconTint="#FFFFFF"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="32dp"
                app:chipStartPadding="0dp"
                app:chipEndPadding="0dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/color1"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:checkable="true"
                android:contentDescription="Green"
                app:chipBackgroundColor="@color/Green"
                app:chipCornerRadius="16dp"
                app:checkedIconVisible="true"
                app:checkedIcon="@drawable/ic_check"
                app:checkedIconTint="#FFFFFF"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="32dp"
                app:chipStartPadding="0dp"
                app:chipEndPadding="0dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/color2"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:checkable="true"
                android:contentDescription="Yellow"
                app:chipBackgroundColor="@color/Yellow"
                app:chipCornerRadius="16dp"
                app:checkedIconVisible="true"
                app:checkedIcon="@drawable/ic_check"
                app:checkedIconTint="#FFFFFF"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="32dp"
                app:chipStartPadding="0dp"
                app:chipEndPadding="0dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/color3"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:checkable="true"
                android:contentDescription="Orange"
                app:chipBackgroundColor="@color/Orange"
                app:chipCornerRadius="16dp"
                app:checkedIconVisible="true"
                app:checkedIcon="@drawable/ic_check"
                app:checkedIconTint="#FFFFFF"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="32dp"
                app:chipStartPadding="0dp"
                app:chipEndPadding="0dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/color4"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:checkable="true"
                android:contentDescription="Red"
                app:chipBackgroundColor="@color/Red"
                app:chipCornerRadius="16dp"
                app:checkedIconVisible="true"
                app:checkedIcon="@drawable/ic_check"
                app:checkedIconTint="#FFFFFF"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="32dp"
                app:chipStartPadding="0dp"
                app:chipEndPadding="0dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/color5"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:checkable="true"
                android:contentDescription="Dark Gray"
                app:chipBackgroundColor="@color/Dark_gray"
                app:chipCornerRadius="16dp"
                app:checkedIconVisible="true"
                app:checkedIcon="@drawable/ic_check"
                app:checkedIconTint="#FFFFFF"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="32dp"
                app:chipStartPadding="0dp"
                app:chipEndPadding="0dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <!-- Move to Trash: visible only when editing -->
    <TextView
        android:id="@+id/moveToTrashButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Move to Trash"
        android:textColor="#FF4164"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_trash_button"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</LinearLayout>