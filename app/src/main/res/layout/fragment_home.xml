<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1B1D1E">

    <TextView
        android:id="@+id/noteCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12 notes"
        android:textColor="#A9AAAA"
        android:textSize="15sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notes"
            android:textColor="#FAF7F4"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/filterBy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_filter"
            android:src="@drawable/ic_sort"
            android:contentDescription="Open trash"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/openTrashButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_trash_button"
            android:src="@drawable/ic_trash"
            android:contentDescription="Open trash"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <EditText
        android:id="@+id/searchNotes"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:hint="Search notes"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#969A9B"
        android:textSize="13sp"
        android:singleLine="true"
        android:inputType="text"/>

    <HorizontalScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- All Filter -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:minWidth="44dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@drawable/bg_filter"
                android:backgroundTint="@null" />

            <!-- Color Filters -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/colorChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                app:singleSelection="true"
                app:selectionRequired="false"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/color0"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:contentDescription="Default color"
                    app:chipBackgroundColor="@color/Charcoal"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="true"
                    app:checkedIcon="@drawable/ic_check"
                    app:checkedIconTint="#FFFFFF"
                    app:closeIconVisible="false"
                    app:ensureMinTouchTargetSize="false"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="0dp"
                    app:chipEndPadding="0dp"
                    app:textStartPadding="0dp"
                    app:textEndPadding="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/color1"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:contentDescription="Green"
                    app:chipBackgroundColor="@color/Green"
                    app:chipCornerRadius="16dp"
                    app:checkedIconVisible="true"
                    app:checkedIcon="@drawable/ic_check"
                    app:checkedIconTint="#FFFFFF"
                    app:closeIconVisible="false"
                    app:ensureMinTouchTargetSize="false"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="0dp"
                    app:chipEndPadding="0dp"
                    app:textStartPadding="0dp"
                    app:textEndPadding="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/color2"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:contentDescription="Yellow"
                    app:chipBackgroundColor="@color/Yellow"
                    app:chipCornerRadius="16dp"
                    app:checkedIconVisible="true"
                    app:checkedIcon="@drawable/ic_check"
                    app:checkedIconTint="#FFFFFF"
                    app:closeIconVisible="false"
                    app:ensureMinTouchTargetSize="false"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="0dp"
                    app:chipEndPadding="0dp"
                    app:textStartPadding="0dp"
                    app:textEndPadding="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/color3"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:contentDescription="Orange"
                    app:chipBackgroundColor="@color/Orange"
                    app:chipCornerRadius="16dp"
                    app:checkedIconVisible="true"
                    app:checkedIcon="@drawable/ic_check"
                    app:checkedIconTint="#FFFFFF"
                    app:closeIconVisible="false"
                    app:ensureMinTouchTargetSize="false"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="0dp"
                    app:chipEndPadding="0dp"
                    app:textStartPadding="0dp"
                    app:textEndPadding="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/color4"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:contentDescription="Red"
                    app:chipBackgroundColor="@color/Red"
                    app:chipCornerRadius="16dp"
                    app:checkedIconVisible="true"
                    app:checkedIcon="@drawable/ic_check"
                    app:checkedIconTint="#FFFFFF"
                    app:closeIconVisible="false"
                    app:ensureMinTouchTargetSize="false"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="0dp"
                    app:chipEndPadding="0dp"
                    app:textStartPadding="0dp"
                    app:textEndPadding="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/color5"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:checkable="true"
                    android:contentDescription="Dark Gray"
                    app:chipBackgroundColor="@color/Dark_gray"
                    app:chipCornerRadius="16dp"
                    app:checkedIconVisible="true"
                    app:checkedIcon="@drawable/ic_check"
                    app:checkedIconTint="#FFFFFF"
                    app:closeIconVisible="false"
                    app:ensureMinTouchTargetSize="false"
                    app:chipMinHeight="32dp"
                    app:chipStartPadding="0dp"
                    app:chipEndPadding="0dp"
                    app:textStartPadding="0dp"
                    app:textEndPadding="0dp" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Newest first · tap ⇅ for oldest first"
        android:textColor="#A9AAAA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notesRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="76dp"
            android:overScrollMode="never" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:contentDescription="Add notes"
            app:backgroundTint="@color/Accent_teal"
            app:tint="#FFFFFF"
            android:src="@drawable/ic_add"/>

    </FrameLayout>

</LinearLayout>
