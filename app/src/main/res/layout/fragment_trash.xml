<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1B1D1E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:text="Trash"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/emptyTrashButton"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Empty"
            android:textColor="#FF4164"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_trash_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

    </LinearLayout>

    <!-- Trash information -->
    <TextView
        android:id="@+id/trashCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="0 deleted notes"
        android:textColor="#A9AAAA"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Notes are permanently removed after 30 days"
        android:textColor="#777B7C"
        android:textSize="15sp" />

    <!-- Deleted Notes List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trashRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:overScrollMode="never" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/emptyTrashMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="Your trash is empty."
        android:textColor="#A9AAAA"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="Restore notes to return them to your collection."
        android:textColor="#777B7C"
        android:textSize="15sp" />

</LinearLayout>