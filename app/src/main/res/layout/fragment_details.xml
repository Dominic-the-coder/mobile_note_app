<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1D1E"
    tools:context=".ui.detail.DetailsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Go back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/editNoteButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_restore_button"
                android:contentDescription="Edit note"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/deleteNoteButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_trash_button"
                android:contentDescription="Move note to trash"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_trash"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Note title -->
        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Text Title"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="My Note Title" />

        <!-- Last edited -->
        <TextView
            android:id="@+id/detailDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Last edited just now"
            android:textColor="#A9AAAA"
            android:textSize="15sp"
            tools:text="Last edited just now" />

        <!-- Note content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="24dp"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/detailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:padding="0dp"
                android:textColor="#F0F0F0"
                android:textColorHint="#888888"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                tools:text="Write your note content here..." />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
